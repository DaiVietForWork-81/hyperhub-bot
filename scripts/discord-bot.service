[Unit]
Description=Discord Competitive Programming & AI Supervisor Bot
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
# Thay đổi 'ubuntu' thành user thực tế chạy bot trên máy chủ của bạn
User=ubuntu
Group=ubuntu
# Thay đổi đường dẫn WorkingDirectory tới thư mục dự án của bạn
WorkingDirectory=/home/ubuntu/Project

# Kích hoạt virtualenv python
ExecStart=/home/ubuntu/Project/venv/bin/python bot.py

# Tự động restart sau 5 giây nếu bot bị crash
Restart=always
RestartSec=5s

# Thiết lập biến môi trường
Environment="PYTHONUNBUFFERED=1"
Environment="LANG=C.UTF-8"
Environment="LC_ALL=C.UTF-8"

# Giới hạn tài nguyên nếu cần
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
