# ==============================================================================
# DISCORD COMPETITIVE PROGRAMMING BOT — CẤU HÌNH MẪU (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế của bạn
# ==============================================================================

# Token xác thực Discord Bot (Lấy từ https://discord.com/developers/applications)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# ID tài khoản Discord của Bot Owner (Có toàn quyền quản trị)
OWNER_ID=1529864608813416449

# ==============================================================================
# DANH SÁCH ID THƯ MỤC & CÁC KÊNH DISCORD (CATEGORY: ・━━ ❓GIẢI ĐỀ/CÂU HỎI ━━・)
# ==============================================================================
CATEGORY_ID=1534147796461162697        # Thư mục: ・━━ ❓GIẢI ĐỀ/CÂU HỎI ━━・
CHON_ID=1541436758904799392            # Kênh #📤・mode (Sổ tay 6 Embeds phân tích 2 chế độ làm bài)
BAITAP_ID=1535556189914398760          # Kênh #📋・contest (Danh mục cuộc thi & bài tập theo Div/Tier)
RANKED_CHANNEL_ID=1543496098394546216  # Kênh #📋・ranked (Dành cho chế độ thi đấu Ranked)
SUBMIT_ID=1535556232637714543          # Kênh #📤・submit (Trạm nộp bài trực tiếp qua Form Modal)
CF_ID=1535556274589274142              # Kênh #✅・accounts (Kênh liên kết tài khoản Codeforces tự động)
UP_RANK=1541436943458508922            # Kênh #✅・leaderboard (Bảng Xếp Hạng Top 50 toàn Server)
WINNER_CHANNEL_ID=1543532432169377904  # Kênh #🏆・winner (Thông báo vinh danh người chiến thắng Ranked 1:1)
PROBLEM_ARCHIVE_CHANNEL_ID=1548627763467128912  # Kênh lưu trữ đề bài, editorial & code mẫu tự động (Freedom/Ranked)
GIAM_KHAO_ROLE_ID=1534146463246974995  # Role Moderator / Giám Khảo (Được quyền quan sát kênh thi đấu)

# Đường dẫn ảnh Logo của Bot (Dùng làm Thumbnail/Icon cho Embeds)
LOGO_ID=https://assets.codeforces.com/favicon-96x96.png

# ==============================================================================
# ROLE THÀNH VIÊN MẶC ĐỊNH (TỰ ĐỘNG CẤP CHO TẤT CẢ MỌI NGƯỜI)
# ==============================================================================
# @🌱 Học sinh - Role thành viên cơ bản tự động gán cho mọi người khi vào server & khi bot chạy
MEMBER_ROLE_ID=1532397716598948050

# ==============================================================================
# === RETIRED (RHT1) === (Role Giải Nghệ Riêng Biệt)
# ==============================================================================
# @🏆RHT1 - Role Giải Nghệ (Retired) dành cho cựu thí sinh (Bảo lưu thành tích Peak pts)
R_ID=1541025570010431518

# ==============================================================================
# === FREEDOM === (Danh sách Role Freedom)
# ==============================================================================
HT1_FREEDOM_ROLE_ID=1534128842866950164   # 👑 HT1 - Freedom (Rating >= 3000 pts)
MT1_FREEDOM_ROLE_ID=1534128844880220211   # 💎MT1 - Freedom (Rating 2600 - 2999 pts)
LT1_FREEDOM_ROLE_ID=1543471701373886525   # 🏆LT1 - Freedom (Rating 2400 - 2599 pts)
HT2_FREEDOM_ROLE_ID=1543471743086100591   # 🔱HT2 - Freedom (Rating 2300 - 2399 pts)
MT2_FREEDOM_ROLE_ID=1543471762421973042   # ⚜️MT2 - Freedom (Rating 2100 - 2299 pts)
LT2_FREEDOM_ROLE_ID=1543471773885009960   # 🛡️LT2 - Freedom (Rating 1900 - 2099 pts)
T3_FREEDOM_ROLE_ID=1543471715420606474    # 💠T3 - Freedom (Rating 1600 - 1899 pts)
T4_FREEDOM_ROLE_ID=1543471785138458714    # 🔷T4 - Freedom (Rating 1400 - 1599 pts)
T5_FREEDOM_ROLE_ID=1543471796458758144    # 🔶T5 - Freedom (Rating 1200 - 1399 pts)
T6_FREEDOM_ROLE_ID=1543471811012861953    # ⭐T6 - Freedom (Rating 700 - 1199 pts)
T7_FREEDOM_ROLE_ID=1543471821603733605    # ⭐T7 - Freedom (Rating 400 - 699 pts)
T8_FREEDOM_ROLE_ID=1543471838619901973    # ⭐T8 - Freedom (Rating < 400 pts)

# ==============================================================================
# === RANKED === (Danh sách Role Ranked - Dành cho dự án CP Bot & Dự án tiếp)
# ==============================================================================
HT1_RANKED_ROLE_ID=1543471664275136552    # 👑 HT1 - Ranked (Rating >= 3000 pts)
MT1_RANKED_ROLE_ID=1543471683472457728    # 💎MT1 - Ranked (Rating 2600 - 2999 pts)
LT1_RANKED_ROLE_ID=1534128843474866186    # 🏆LT1 - Ranked (Rating 2400 - 2599 pts)
HT2_RANKED_ROLE_ID=1532398016164790396    # 🔱HT2 - Ranked (Rating 2300 - 2399 pts)
MT2_RANKED_ROLE_ID=1534128562637111308    # ⚜️MT2 - Ranked (Rating 2100 - 2299 pts)
LT2_RANKED_ROLE_ID=1532397868835537087    # 🛡️LT2 - Ranked (Rating 1900 - 2099 pts)
T3_RANKED_ROLE_ID=1532397826225737799     # 💠T3 - Ranked (Rating 1600 - 1899 pts)
T4_RANKED_ROLE_ID=1532397764212949205     # 🔷T4 - Ranked (Rating 1400 - 1599 pts)
T5_RANKED_ROLE_ID=1541025416519884930     # 🔶T5 - Ranked (Rating 1200 - 1399 pts)
T6_RANKED_ROLE_ID=1541025407451795557     # ⭐T6 - Ranked (Rating 700 - 1199 pts)
T7_RANKED_ROLE_ID=1541433605748695050     # ⭐T7 - Ranked (Rating 400 - 699 pts)
T8_RANKED_ROLE_ID=1541433592008417390     # ⭐T8 - Ranked (Rating < 400 pts)

# ==============================================================================
# CƠ SỞ DỮ LIỆU (DATABASE)
# ==============================================================================
DATABASE_URL=sqlite+aiosqlite:///bot.db

# ==============================================================================
# CẤU HÌNH CODEFORCES API
# ==============================================================================
CF_API_KEY=your_codeforces_api_key_here
CF_API_SECRET=your_codeforces_api_secret_here
CF_SYNC_INTERVAL_SECONDS=45

# ==============================================================================
# CẤU HÌNH TRÌNH CHẤM BÀI SANDBOX (JUDGE)
# ==============================================================================
JUDGE_TIMEOUT=5
JUDGE_MEMORY_LIMIT=256
JUDGE_CPU_LIMIT=2
JUDGE_PIDS_LIMIT=64
DOCKER_SANDBOX_IMAGE=cp-sandbox:latest
USE_DOCKER_SANDBOX=true

# ==============================================================================
# BẢO MẬT & CHỐNG GIAN LẬN (SECURITY & LIMITS)
# ==============================================================================
MAX_CODE_LENGTH=65536
SUBMIT_COOLDOWN_SECONDS=15
AI_SUSPICION_THRESHOLD=65
LOG_LEVEL=INFO

# RAM thấp (VPS 512MB): false = tắt model embedding ONNX (~550MB), tìm kiếm dùng BM25/FTS
EMBEDDING_ENABLED=true
# Thiết bị chạy embedding: auto (có GPU dùng GPU, không thì CPU) | cpu | cuda
EMBEDDING_DEVICE=auto
# Trần VRAM (GB) cho GPU. Vượt trần hoặc lỗi GPU -> tự rớt về CPU
EMBEDDING_GPU_MEM_GB=1.0

# ==============================================================================
# LOCAL AI CORE (QWEN3:4B-INSTRUCT VIA OLLAMA)
# ==============================================================================
AI_MODEL=qwen3:4b-q4_K_M
OLLAMA_MODEL=qwen3:4b-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=1800
# Số layer offload lên GPU: 0 = để Ollama tự quyết (khuyến nghị), 999 = ép full GPU
OLLAMA_NUM_GPU=0
AI_CORE_CHANNEL_ID=1544356764240183358
AI_CHAT_CHANNEL_ID=0
