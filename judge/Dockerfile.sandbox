# Multi-language secure sandbox image for Competitive Programming Judge
FROM ubuntu:22.04

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    python3 \
    python3-pip \
    openjdk-17-jdk-headless \
    rustc \
    golang-go \
    nodejs \
    mono-mcs \
    time \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged sandbox user
RUN useradd -m -u 1000 -s /bin/bash sandbox

# Setup isolated sandbox workspace
RUN mkdir -p /sandbox && chown -R sandbox:sandbox /sandbox
WORKDIR /sandbox

USER sandbox
CMD ["/bin/sh"]
